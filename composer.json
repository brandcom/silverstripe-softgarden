{
    "name": "brandcom/silverstripe-softgarden",
    "type": "silverstripe-vendormodule",
    "description": "",
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5"
    },
    "autoload": {
        "psr-4": {
            "brandcom\\Softgarden\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
